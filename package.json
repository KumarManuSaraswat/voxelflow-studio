{
  "name": "voxelflow-studio",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "An artist-first Blockbench creative pipeline with quality gates and a local MCP companion.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node packages/mcp-server/dist/server.js",
    "bridge": "node packages/mcp-server/dist/bridge-cli.js",
    "examples": "tsx scripts/examples.ts",
    "examples:props": "tsx scripts/prop-examples.ts",
    "demo": "tsx scripts/demo-client.ts",
    "verify:live-export": "tsx scripts/verify-live-export.ts",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run examples && npm run examples:props"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "blockbench-types": "5.2.1",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
